# Supabase (Project Settings → API)
# Use the publishable / anon key — never the service_role or secret key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── TTS (pick one — Azure is best for Arabic emphatics ص/ط) ───
#
# 1) RECOMMENDED: Azure Speech (free F0 tier works)
#    Azure Portal → Create "Speech service" → Keys and Endpoint
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus
#
# 2) Google Cloud Text-to-Speech WaveNet
#    Console → enable Cloud Text-to-Speech API → create API key
# GOOGLE_TTS_API_KEY=
# GOOGLE_TTS_VOICE=ar-XA-Wavenet-B
#
# 3) OpenAI gpt-4o-mini-tts (good with Arabic instructions)
# OPENAI_API_KEY=
#
# Without keys, Nawā falls back to free Edge neural (less reliable on short phonemes).
