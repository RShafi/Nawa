# Supabase (Project Settings → API)
# Use the publishable / anon key — never the service_role or secret key in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── TTS (Path / lessons — ElevenLabs ONLY) ───
#
# Required:
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
#
# Audio is cached under public/tts/ keyed by hash(voiceId + "_" + text).
# Restart `npm run dev` after changing env vars.
